{
  // The program of the app Worker (wrangler.toml): src/ without the ChatGPT Worker, and its generated types, which
  // hold both the runtime and the env. Nothing in this program may import src/chatgpt. Three more programs
  // extend this one, each with one Worker's generated types (never both: they declare the same globals):
  // src/chatgpt/tsconfig.json, test/tsconfig.json (the app's tests), test/chatgpt/tsconfig.json. `npm run typecheck`
  // runs all four.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["worker-configuration.d.ts", "secrets.d.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/chatgpt"]
}
