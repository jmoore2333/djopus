{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "declaration": true
  },
  "include": ["src/**/*.ts", "../src/core/tools.ts"],
  "exclude": ["node_modules", "dist"]
}
